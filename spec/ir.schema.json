{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Roadbook IR 0.6",
  "description": "The compiled form of a Roadbook project: one document per entry file. See spec/ir.md for what each member means. Every member listed is required; absent values are null, missing docs are \"\", and empty lists and maps are [] and {}.",
  "type": "object",
  "additionalProperties": false,
  "required": ["irVersion", "sources", "types", "functions", "actions", "tasks", "machines"],
  "properties": {
    "irVersion": { "const": "0.6" },
    "sources": {
      "description": "Source files, entry file first. Spans refer to them by index.",
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/source" }
    },
    "types": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/upperName" },
      "additionalProperties": { "$ref": "#/$defs/typeDecl" }
    },
    "functions": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/lowerName" },
      "additionalProperties": { "$ref": "#/$defs/functionDecl" }
    },
    "actions": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/lowerName" },
      "additionalProperties": { "$ref": "#/$defs/actionDecl" }
    },
    "tasks": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/lowerName" },
      "additionalProperties": { "$ref": "#/$defs/taskDecl" }
    },
    "machines": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/upperName" },
      "additionalProperties": { "$ref": "#/$defs/machine" }
    }
  },
  "$defs": {
    "upperName": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" },
    "lowerName": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
    "typeRef": {
      "description": "A type in canonical source form: a built-in, a declared name with optional type arguments (Page<Order>), an event type Machine.Event, ref Machine, or map<K, V>, then any number of [] and ? suffixes. The pattern checks the tokens only; spec/ir.md gives the exact grammar, whose nesting a regular expression cannot check.",
      "type": "string",
      "pattern": "^(ref [A-Z][A-Za-z0-9]*|[A-Za-z][A-Za-z0-9]*(\\.[A-Z][A-Za-z0-9]*)?)(<|, |>|\\[\\]|\\?|ref [A-Z][A-Za-z0-9]*|[A-Za-z][A-Za-z0-9]*(\\.[A-Z][A-Za-z0-9]*)?)*$"
    },
    "typeParams": {
      "description": "The type parameters of a generic record or alias, in order; [] unless it is generic.",
      "type": "array",
      "items": { "$ref": "#/$defs/upperName" },
      "uniqueItems": true
    },
    "eventType": {
      "description": "The type of an event value: an event of the machine by its bare name, or Machine.Event.",
      "type": "string",
      "pattern": "^[A-Z][A-Za-z0-9]*(\\.[A-Z][A-Za-z0-9]*)?$"
    },
    "instanceType": {
      "description": "The type of a value of a generic record: its name and type arguments, as in typeRef.",
      "type": "string",
      "pattern": "^[A-Z][A-Za-z0-9]*<.*>$"
    },
    "stateId": {
      "description": "Absolute dotted path of a state, starting with the machine name.",
      "type": "string",
      "pattern": "^[A-Z][A-Za-z0-9]*(\\.[A-Z][A-Za-z0-9]*)*$"
    },
    "doc": { "description": "Doc comment text, \"\" if none.", "type": "string" },
    "safeInteger": { "type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991 },

    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "package"],
      "properties": {
        "path": {
          "description": "With / separators: relative to the project root, or to the package's root for a file of another package.",
          "type": "string",
          "pattern": "^[^/\\\\][^\\\\]*$"
        },
        "package": {
          "description": "The package the file belongs to, or null for a file of the project.",
          "oneOf": [
            { "type": "string", "pattern": "^(@[^/@\\s]+/)?[^/@\\s]+$" },
            { "type": "null" }
          ]
        }
      }
    },
    "span": {
      "description": "1-based lines and columns; columns count Unicode scalar values; the end is exclusive.",
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "line", "col", "endLine", "endCol"],
      "properties": {
        "file": { "type": "integer", "minimum": 0 },
        "line": { "type": "integer", "minimum": 1 },
        "col": { "type": "integer", "minimum": 1 },
        "endLine": { "type": "integer", "minimum": 1 },
        "endCol": { "type": "integer", "minimum": 1 }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "sensitive", "doc"],
      "properties": {
        "name": { "$ref": "#/$defs/lowerName" },
        "type": { "$ref": "#/$defs/typeRef" },
        "sensitive": { "$ref": "#/$defs/sensitive" },
        "doc": { "$ref": "#/$defs/doc" }
      }
    },
    "fields": { "type": "array", "items": { "$ref": "#/$defs/field" } },
    "sensitive": {
      "description": "Marked `sensitive`: trace records show the value as \"<redacted>\" (spec/trace.md#redaction).",
      "type": "boolean"
    },
    "errors": {
      "description": "Names of error types, in source order.",
      "type": "array",
      "items": { "$ref": "#/$defs/upperName" }
    },

    "typeDecl": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "params", "fields", "doc", "span"],
          "properties": {
            "kind": { "const": "record" },
            "params": { "$ref": "#/$defs/typeParams" },
            "fields": { "$ref": "#/$defs/fields" },
            "doc": { "$ref": "#/$defs/doc" },
            "span": { "$ref": "#/$defs/span" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "params", "type", "doc", "span"],
          "properties": {
            "kind": { "const": "alias" },
            "params": { "$ref": "#/$defs/typeParams" },
            "type": { "$ref": "#/$defs/typeRef" },
            "doc": { "$ref": "#/$defs/doc" },
            "span": { "$ref": "#/$defs/span" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "variants", "doc", "span"],
          "properties": {
            "kind": { "const": "enum" },
            "variants": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/upperName" } },
            "doc": { "$ref": "#/$defs/doc" },
            "span": { "$ref": "#/$defs/span" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "fields", "doc", "span"],
          "properties": {
            "kind": { "const": "error" },
            "fields": { "$ref": "#/$defs/fields" },
            "doc": { "$ref": "#/$defs/doc" },
            "span": { "$ref": "#/$defs/span" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "doc", "span"],
          "properties": {
            "kind": { "const": "extern" },
            "doc": { "$ref": "#/$defs/doc" },
            "span": { "$ref": "#/$defs/span" }
          }
        }
      ]
    },
    "functionDecl": {
      "type": "object",
      "additionalProperties": false,
      "required": ["params", "returns", "doc", "span"],
      "properties": {
        "params": { "$ref": "#/$defs/fields" },
        "returns": { "$ref": "#/$defs/typeRef" },
        "doc": { "$ref": "#/$defs/doc" },
        "span": { "$ref": "#/$defs/span" }
      }
    },
    "actionDecl": {
      "type": "object",
      "additionalProperties": false,
      "required": ["params", "doc", "span"],
      "properties": {
        "params": { "$ref": "#/$defs/fields" },
        "doc": { "$ref": "#/$defs/doc" },
        "span": { "$ref": "#/$defs/span" }
      }
    },
    "taskDecl": {
      "type": "object",
      "additionalProperties": false,
      "required": ["params", "returns", "errors", "doc", "span"],
      "properties": {
        "params": { "$ref": "#/$defs/fields" },
        "returns": { "oneOf": [{ "$ref": "#/$defs/typeRef" }, { "type": "null" }] },
        "errors": { "$ref": "#/$defs/errors" },
        "doc": { "$ref": "#/$defs/doc" },
        "span": { "$ref": "#/$defs/span" }
      }
    },

    "machine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["doc", "span", "params", "returns", "errors", "vars", "events", "emits", "children", "root", "hash"],
      "properties": {
        "doc": { "$ref": "#/$defs/doc" },
        "span": { "$ref": "#/$defs/span" },
        "params": { "$ref": "#/$defs/fields" },
        "returns": { "oneOf": [{ "$ref": "#/$defs/typeRef" }, { "type": "null" }] },
        "errors": { "$ref": "#/$defs/errors" },
        "vars": { "type": "array", "items": { "$ref": "#/$defs/var" } },
        "events": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/upperName" },
          "additionalProperties": { "$ref": "#/$defs/eventDecl" }
        },
        "emits": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/upperName" },
          "additionalProperties": { "$ref": "#/$defs/eventDecl" }
        },
        "children": {
          "description": "The machine's keyed collections of spawned children, by name.",
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/lowerName" },
          "additionalProperties": { "$ref": "#/$defs/childrenDecl" }
        },
        "root": {
          "description": "The machine body as a compound state whose id and name are the machine name.",
          "allOf": [
            { "$ref": "#/$defs/state" },
            {
              "properties": {
                "id": { "$ref": "#/$defs/upperName" },
                "kind": { "const": "compound" }
              }
            }
          ]
        },
        "hash": {
          "description": "sha256: and the lowercase hex SHA-256 of the canonical JSON of the machine's semantic view.",
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "var": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "sensitive", "init", "doc", "span"],
      "properties": {
        "name": { "$ref": "#/$defs/lowerName" },
        "type": { "$ref": "#/$defs/typeRef" },
        "sensitive": { "$ref": "#/$defs/sensitive" },
        "init": { "oneOf": [{ "$ref": "#/$defs/expr" }, { "type": "null" }] },
        "doc": { "$ref": "#/$defs/doc" },
        "span": { "$ref": "#/$defs/span" }
      }
    },
    "childrenDecl": {
      "type": "object",
      "additionalProperties": false,
      "required": ["machine", "key", "doc", "span"],
      "properties": {
        "machine": { "$ref": "#/$defs/upperName" },
        "key": { "description": "The key type: string, int or an enum, or an alias of one.", "$ref": "#/$defs/typeRef" },
        "doc": { "$ref": "#/$defs/doc" },
        "span": { "$ref": "#/$defs/span" }
      }
    },
    "eventDecl": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fields", "doc", "span"],
      "properties": {
        "fields": { "$ref": "#/$defs/fields" },
        "doc": { "$ref": "#/$defs/doc" },
        "span": { "$ref": "#/$defs/span" }
      }
    },

    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "name", "kind", "doc", "span", "initial", "states", "entry", "exit",
        "invoke", "transitions", "output", "fail"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/stateId" },
        "name": { "$ref": "#/$defs/upperName" },
        "kind": { "enum": ["atomic", "compound", "parallel", "final", "history", "deepHistory"] },
        "doc": { "$ref": "#/$defs/doc" },
        "span": { "$ref": "#/$defs/span" },
        "initial": { "oneOf": [{ "$ref": "#/$defs/stateId" }, { "type": "null" }] },
        "states": { "type": "array", "items": { "$ref": "#/$defs/state" } },
        "entry": { "type": "array", "items": { "$ref": "#/$defs/effect" } },
        "exit": { "type": "array", "items": { "$ref": "#/$defs/effect" } },
        "invoke": { "oneOf": [{ "$ref": "#/$defs/invoke" }, { "type": "null" }] },
        "transitions": { "type": "array", "items": { "$ref": "#/$defs/transition" } },
        "output": { "oneOf": [{ "$ref": "#/$defs/expr" }, { "type": "null" }] },
        "fail": { "oneOf": [{ "$ref": "#/$defs/expr" }, { "type": "null" }] }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "compound" } } },
          "then": { "properties": { "initial": { "type": "string" }, "states": { "minItems": 1 } } },
          "else": { "properties": { "initial": { "type": "null" } } }
        },
        {
          "if": { "properties": { "kind": { "enum": ["atomic", "final", "history", "deepHistory"] } } },
          "then": { "properties": { "states": { "maxItems": 0 } } }
        },
        {
          "description": "A history state is a pseudo-state: no effects, work or transitions.",
          "if": { "properties": { "kind": { "enum": ["history", "deepHistory"] } } },
          "then": {
            "properties": {
              "entry": { "maxItems": 0 },
              "exit": { "maxItems": 0 },
              "invoke": { "type": "null" },
              "transitions": { "maxItems": 0 }
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "parallel" } } },
          "then": { "properties": { "states": { "minItems": 1 } } }
        },
        {
          "if": { "properties": { "kind": { "not": { "const": "final" } } } },
          "then": { "properties": { "output": { "type": "null" }, "fail": { "type": "null" } } }
        }
      ]
    },
    "invoke": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "src", "as", "args", "span"],
      "properties": {
        "kind": { "enum": ["task", "machine"] },
        "src": { "type": "string" },
        "as": { "oneOf": [{ "$ref": "#/$defs/lowerName" }, { "type": "null" }] },
        "args": { "type": "array", "items": { "$ref": "#/$defs/expr" } },
        "span": { "$ref": "#/$defs/span" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "task" } } },
          "then": { "properties": { "src": { "$ref": "#/$defs/lowerName" }, "as": { "type": "null" } } },
          "else": { "properties": { "src": { "$ref": "#/$defs/upperName" } } }
        }
      ]
    },
    "address": {
      "description": "Another running machine: an invoked child by its as name, a parameter or variable of type ref, or a children collection.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name", "machine", "state"],
      "properties": {
        "kind": { "enum": ["child", "ref", "children"] },
        "name": { "$ref": "#/$defs/lowerName" },
        "machine": { "$ref": "#/$defs/upperName" },
        "state": { "oneOf": [{ "$ref": "#/$defs/stateId" }, { "type": "null" }] }
      },
      "if": { "properties": { "kind": { "const": "child" } } },
      "then": { "properties": { "state": { "$ref": "#/$defs/stateId" } } },
      "else": { "properties": { "state": { "type": "null" } } }
    },
    "eventValue": {
      "description": "The value of a sent or emitted event: a record expression whose type is the event.",
      "allOf": [
        { "$ref": "#/$defs/expr" },
        { "properties": { "kind": { "const": "record" }, "type": { "$ref": "#/$defs/eventType" } } }
      ]
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trigger", "group", "guard", "target", "effects", "span"],
      "properties": {
        "trigger": { "$ref": "#/$defs/trigger" },
        "group": { "type": "integer", "minimum": 0 },
        "guard": { "oneOf": [{ "$ref": "#/$defs/expr" }, { "type": "null" }] },
        "target": { "oneOf": [{ "$ref": "#/$defs/stateId" }, { "type": "null" }] },
        "effects": { "type": "array", "items": { "$ref": "#/$defs/effect" } },
        "span": { "$ref": "#/$defs/span" }
      }
    },
    "trigger": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "event"],
          "properties": { "kind": { "const": "event" }, "event": { "$ref": "#/$defs/upperName" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "from", "event"],
          "properties": {
            "kind": { "const": "emitted" },
            "from": { "$ref": "#/$defs/address" },
            "event": { "$ref": "#/$defs/upperName" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "enum": ["any", "always", "done", "invoke.done"] } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "delay"],
          "properties": { "kind": { "const": "after" }, "delay": { "$ref": "#/$defs/expr" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "error"],
          "properties": {
            "kind": { "const": "invoke.fail" },
            "error": { "oneOf": [{ "$ref": "#/$defs/upperName" }, { "const": "*" }] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "children"],
          "properties": { "kind": { "const": "spawn.done" }, "children": { "$ref": "#/$defs/lowerName" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "children", "error"],
          "properties": {
            "kind": { "const": "spawn.fail" },
            "children": { "$ref": "#/$defs/lowerName" },
            "error": { "oneOf": [{ "$ref": "#/$defs/upperName" }, { "const": "*" }] }
          }
        }
      ]
    },
    "effect": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "var", "value"],
          "properties": {
            "kind": { "const": "set" },
            "var": { "$ref": "#/$defs/lowerName" },
            "value": { "$ref": "#/$defs/expr" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "action", "args"],
          "properties": {
            "kind": { "const": "do" },
            "action": { "$ref": "#/$defs/lowerName" },
            "args": { "type": "array", "items": { "$ref": "#/$defs/expr" } }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "to", "key", "event", "value"],
          "properties": {
            "kind": { "const": "send" },
            "to": { "$ref": "#/$defs/address" },
            "key": {
              "description": "For an address of kind children, the key expression, or null for every child (send name.*.E). Null for the other kinds.",
              "oneOf": [{ "$ref": "#/$defs/expr" }, { "type": "null" }]
            },
            "event": { "$ref": "#/$defs/upperName" },
            "value": { "$ref": "#/$defs/eventValue" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "event", "value"],
          "properties": {
            "kind": { "const": "emit" },
            "event": { "$ref": "#/$defs/upperName" },
            "value": { "$ref": "#/$defs/eventValue" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "children", "machine", "key", "args"],
          "properties": {
            "kind": { "const": "spawn" },
            "children": { "$ref": "#/$defs/lowerName" },
            "machine": { "$ref": "#/$defs/upperName" },
            "key": { "$ref": "#/$defs/expr" },
            "args": { "type": "array", "items": { "$ref": "#/$defs/expr" } }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "children", "key"],
          "properties": {
            "kind": { "const": "stop" },
            "children": { "$ref": "#/$defs/lowerName" },
            "key": { "$ref": "#/$defs/expr" }
          }
        }
      ]
    },

    "expr": {
      "description": "An expression node. Every node has kind, its own members, then type (a typeRef) and text (canonical source form).",
      "oneOf": [
        { "$ref": "#/$defs/litExpr" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "path", "type", "text"],
          "properties": {
            "kind": { "const": "ref" },
            "path": {
              "description": "A variable, parameter or event/result/error/key, then field names.",
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/lowerName" }
            },
            "type": { "$ref": "#/$defs/typeRef" },
            "text": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "of", "name", "type", "text"],
          "properties": {
            "kind": { "const": "field" },
            "of": { "$ref": "#/$defs/expr" },
            "name": { "$ref": "#/$defs/lowerName" },
            "type": { "$ref": "#/$defs/typeRef" },
            "text": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "fn", "args", "type", "text"],
          "properties": {
            "kind": { "const": "call" },
            "fn": { "$ref": "#/$defs/lowerName" },
            "args": { "type": "array", "items": { "$ref": "#/$defs/expr" } },
            "type": { "$ref": "#/$defs/typeRef" },
            "text": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "op", "args", "type", "text"],
          "properties": {
            "kind": { "const": "op" },
            "op": { "enum": ["==", "!=", "<", "<=", ">", ">=", "+", "-", "*", "and", "or", "not", "neg"] },
            "args": { "type": "array", "minItems": 1, "maxItems": 2, "items": { "$ref": "#/$defs/expr" } },
            "type": { "$ref": "#/$defs/typeRef" },
            "text": { "type": "string" }
          },
          "if": { "properties": { "op": { "enum": ["not", "neg"] } } },
          "then": { "properties": { "args": { "maxItems": 1 } } },
          "else": { "properties": { "args": { "minItems": 2 } } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "fields", "type", "text"],
          "properties": {
            "kind": { "const": "record" },
            "fields": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "value"],
                "properties": {
                  "name": { "$ref": "#/$defs/lowerName" },
                  "value": { "$ref": "#/$defs/expr" }
                }
              }
