{
  "description": "Two gateway failures with growing backoff, then a successful charge. The delay is computed from attempts after Backoff's entry effect has incremented it.",
  "chart": "charts/shop/checkout.road",
  "machine": "Checkout",
  "input": {
    "order": {
      "id": "o1",
      "items": [
        {
          "sku": "apple",
          "qty": 2
        }
      ],
      "totalCents": 4200
    },
    "user": {
      "id": "u1",
      "role": "Customer"
    }
  },
  "stub": [],
  "fns": {
    "retryDelay": [
      {
        "args": [
          1
        ],
        "returns": 200
      },
      {
        "args": [
          2
        ],
        "returns": 400
      }
    ]
  },
  "script": [
    {
      "task": "chargeCard",
      "fail": {
        "_tag": "GatewayUnavailable"
      }
    },
    {
      "advance": 200
    },
    {
      "task": "chargeCard",
      "fail": {
        "_tag": "GatewayUnavailable"
      }
    },
    {
      "advance": 400
    },
    {
      "task": "chargeCard",
      "done": {
        "chargeId": "c1",
        "amountCents": 4200
      }
    }
  ],
  "status": "done"
}
