// Conformance chart: a long-lived Inventory peer and the Orders that hold a
// reference to it, as in examples/orders and examples/inventory. Every order
// receives every reply and picks out its own by id; an order gives up after 5s.

/// One line of an order: a product and how many of it.
type Item { sku: string, qty: int }

/// What the customer is buying.
type OrderDraft { items: Item[], card: string }

/// Proof of payment.
type Receipt { orderId: string, total: int }

/// The warehouse cannot supply every item.
error OutOfStock { reason: string }

/// The card was refused.
error PaymentDeclined

/// Hold `items` for an order, or fail if the warehouse cannot supply them all.
task reserveStock(warehouse: string, orderId: string, items: Item[]) ! OutOfStock

/// Put the items held for an order back on the shelf.
action releaseStock(warehouse: string, orderId: string)

/// Record a delivery.
action addStock(warehouse: string, sku: string, qty: int)

/// Charge the customer for the order.
task charge(orderId: string, draft: OrderDraft) -> Receipt ! PaymentDeclined

/// The stock of one warehouse, shared by every order. It answers a request by
/// emitting Reserved or Rejected with the order's id.
machine Inventory(warehouse: string) {
  var orderId: string
  var items:   Item[]

  event Reserve  { orderId: string, items: Item[] }
  event Release  { orderId: string }
  event Restock  { sku: string, qty: int }
  event Close
  emits Reserved { orderId: string }
  emits Rejected { orderId: string, reason: string }

  initial Ready

  on Release do releaseStock(warehouse, event.orderId)
  on Restock do addStock(warehouse, event.sku, event.qty)

  state Ready {
    on Reserve -> Reserving  set orderId = event.orderId, items = event.items
    on Close   -> Closed
  }

  /// One request at a time: another that arrives meanwhile is turned away.
  state Reserving {
    invoke reserveStock(warehouse, orderId, items) {
      done            -> Ready  emit Reserved { orderId: orderId }
      fail OutOfStock -> Ready  emit Rejected { orderId: orderId, reason: error.reason }
    }
    on Reserve emit Rejected { orderId: event.orderId, reason: "busy" }
  }

  final state Closed {}
}

/// Reserve the items with the warehouse, then take the payment.
machine Order(id: string, draft: OrderDraft, inventory: ref Inventory) -> Receipt ! OutOfStock | PaymentDeclined {
  var receipt: Receipt
  var problem: OutOfStock

  initial Reserving

  state Reserving {
    entry send inventory.Reserve { orderId: id, items: draft.items }
    on inventory.Reserved if event.orderId == id -> Paying
    on inventory.Rejected if event.orderId == id -> Unavailable  set problem = OutOfStock { reason: event.reason }
    after 5s                                     -> Unavailable  set problem = OutOfStock { reason: "the warehouse did not answer" }
  }

  state Paying {
    invoke charge(id, draft) {
      done                 -> Paid      set receipt = result
      fail PaymentDeclined -> Declined  send inventory.Release { orderId: id }
    }
  }

  final state Paid        { output receipt }
  final state Unavailable { fail problem }
  final state Declined    { fail PaymentDeclined }
}
