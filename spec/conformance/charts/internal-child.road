// Conformance chart: an internal transition written in an invoking state keeps its child.

/// A child that answers every `Ping` with a `Pong`.
machine Echo() {
  event Ping
  event Stop
  emits Pong

  initial Ready

  state Ready {
    on Ping             emit Pong
    on Stop -> Stopped
  }

  final state Stopped {}
}

/// An internal transition written in the invoking state does not leave it, so its child keeps
/// running and can be sent to from the transition itself.
machine Caller() {
  event Ping

  initial Talking

  state Talking {
    invoke Echo() as echo {
      done -> Over
    }
    on Ping      -> .Waiting  send echo.Ping
    on echo.Pong -> .Heard

    initial Waiting

    state Waiting {}
    state Heard   {}
  }

  final state Over {}
}
