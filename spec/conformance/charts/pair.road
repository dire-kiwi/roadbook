// Conformance chart: two events sent from one machine to another arrive in the
// order they were sent.

/// Record which machine a sender talks to.
action note(peer: ref Receiver)

/// Must get First before Second.
machine Receiver() {
  event First
  event Second

  initial WaitingFirst

  state WaitingFirst { on First -> WaitingSecond }

  state WaitingSecond { on Second -> Done }

  final state Done {}
}

/// Sends First, then Second, in one transition, to the same peer named two ways.
machine Sender(peer: ref Receiver) {
  /// The same peer, held in a variable: an address can be either.
  var target: ref Receiver = peer

  event Go

  initial Idle

  state Idle { on Go -> Sent  do note(peer)  send peer.First  send target.Second }

  final state Sent {}
}
