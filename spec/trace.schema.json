{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Roadbook trace record",
  "description": "One record of a Roadbook trace: one line of a .jsonl trace file. See spec/trace.md for what each record means and spec/execution.md for when it is written. Every member listed for a kind is required, and no other member is allowed.",
  "type": "object",
  "required": ["t", "run", "kind"],
  "properties": {
    "t": {
      "description": "The driver's clock when the record was written, in integer milliseconds: virtual time from 0 in conformance runs, since the Unix epoch otherwise.",
      "$ref": "#/$defs/safeNatural"
    },
    "run": {
      "description": "The run that wrote the record. A top-level run's id is chosen by the driver; a child run's id is its parent's id, a dot, and the id of the invoke that started it.",
      "$ref": "#/$defs/runId"
    },
    "parent": {
      "description": "The parent run's id. Present exactly on the records of a child run.",
      "$ref": "#/$defs/runId"
    },
    "kind": { "type": "string" }
  },
  "if": { "properties": { "run": { "pattern": "\\." } } },
  "then": { "required": ["parent"] },
  "else": { "not": { "required": ["parent"] } },
  "oneOf": [
    {
      "description": "The run started.",
      "properties": {
        "kind": { "const": "started" },
        "machine": { "$ref": "#/$defs/upperName" },
        "ir": { "$ref": "#/$defs/hash" },
        "input": { "$ref": "#/$defs/args" }
      },
      "required": ["machine", "ir", "input"]
    },
    {
      "description": "The run was restored from a saved snapshot: its first record, in place of `started`.",
      "properties": {
        "kind": { "const": "restored" },
        "machine": { "$ref": "#/$defs/upperName" },
        "ir": { "$ref": "#/$defs/hash" },
        "migrated": {
          "description": "The hash the snapshot had before a migration, or null.",
          "oneOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }]
        },
        "snapshot": {
          "description": "The saved snapshot the run was restored from, after any migration (spec/snapshot.schema.json), without the snapshots of child runs nested in it (child), redacted like every value of a record (spec/trace.md#redaction): not a snapshot to restore.",
          "type": "object",
          "required": ["snapshotVersion", "machine", "run", "ir", "status", "active", "input", "vars", "invokes", "timers", "nextInvoke", "nextTimer", "nextMessage", "result"]
        }
      },
      "required": ["machine", "ir", "migrated", "snapshot"]
    },
    {
      "description": "A state was entered (written before its entry effects).",
      "properties": { "kind": { "const": "entered" }, "state": { "$ref": "#/$defs/stateId" } },
      "required": ["state"]
    },
    {
      "description": "A state was left (written after its work was cancelled and its exit effects ran).",
      "properties": { "kind": { "const": "exited" }, "state": { "$ref": "#/$defs/stateId" } },
      "required": ["state"]
    },
    {
      "description": "The run took an input that enables a transition.",
      "properties": { "kind": { "const": "event" }, "event": { "$ref": "#/$defs/event" } },
      "required": ["event"]
    },
    {
      "description": "The run took an input that enables no transition. Nothing changed.",
      "properties": { "kind": { "const": "dropped" }, "event": { "$ref": "#/$defs/event" } },
      "required": ["event"]
    },
    {
      "description": "The run took the outcome of an invoke or a spawned child, the expiry of a timer, an event emitted by a child run, or an event emitted by a task, whose invoke, spawned child (or spawned task) or timer is no longer running. Nothing changed.",
      "properties": { "kind": { "const": "stale" }, "event": { "$ref": "#/$defs/event" } },
      "required": ["event"]
    },
    {
      "description": "A transition was taken. It is named by its state and its index in that state's transitions.",
      "properties": {
        "kind": { "const": "transition" },
        "from": { "$ref": "#/$defs/stateId" },
        "index": { "$ref": "#/$defs/safeNatural" },
        "to": {
          "description": "The transition's targets, as the IR's targets: [] for a transition with no target.",
          "type": "array",
          "items": { "$ref": "#/$defs/stateId" }
        }
      },
      "required": ["from", "index", "to"]
    },
    {
      "description": "A variable was assigned.",
      "properties": {
        "kind": { "const": "set" },
        "var": { "$ref": "#/$defs/lowerName" },
        "value": { "$ref": "#/$defs/value" }
      },
      "required": ["var", "value"]
    },
    {
      "description": "An action was run (written before the driver runs it).",
      "properties": {
        "kind": { "const": "action" },
        "action": { "$ref": "#/$defs/lowerName" },
        "args": { "$ref": "#/$defs/args" }
      },
      "required": ["action", "args"]
    },
    {
      "description": "A send effect ran: the message is queued for run `to`.",
      "properties": {
        "kind": { "const": "sent" },
        "message": { "$ref": "#/$defs/id" },
        "to": { "$ref": "#/$defs/runId" },
        "value": { "$ref": "#/$defs/tagged" }
      },
      "required": ["message", "to", "value"]
    },
    {
      "description": "An emit effect ran: the event is queued for the run's parent (if it used `as`, or spawned it) and for every run that holds a ref to it.",
      "properties": {
        "kind": { "const": "emitted" },
        "message": { "$ref": "#/$defs/id" },
        "value": { "$ref": "#/$defs/tagged" }
      },
      "required": ["message", "value"]
    },
    {
      "description": "A send reached no run: written by the core with `to` null when the child addressed (invoked, or spawned under a key) is not running, or by the driver after the `sent` record when run `to` has ended.",
      "properties": {
        "kind": { "const": "undelivered" },
        "message": { "$ref": "#/$defs/id" },
        "to": {
          "oneOf": [{ "$ref": "#/$defs/runId" }, { "type": "null" }]
        },
        "value": { "$ref": "#/$defs/tagged" }
      },
      "required": ["message", "to", "value"]
    },
    {
      "description": "A task or child machine was started, or a call was made (src is the address and the call, inventory.reserve). as is the invoke's as name, present exactly when its state has several invokes.",
      "properties": {
        "kind": { "const": "invoke.started" },
        "invoke": { "$ref": "#/$defs/id" },
        "state": { "$ref": "#/$defs/stateId" },
        "src": { "$ref": "#/$defs/src" },
        "as": { "$ref": "#/$defs/lowerName" },
        "args": { "$ref": "#/$defs/args" }
      },
      "required": ["invoke", "state", "src", "args"]
    },
    {
      "description": "A running task, child machine or call was cancelled because its state was left.",
      "properties": {
        "kind": { "const": "invoke.cancelled" },
        "invoke": { "$ref": "#/$defs/id" },
        "state": { "$ref": "#/$defs/stateId" },
        "src": { "$ref": "#/$defs/src" }
      },
      "required": ["invoke", "state", "src"]
    },
    {
      "description": "A call was answered: by a reply effect, or with Unanswered because it enabled no transition. to is the caller's run id and invoke its invoke.",
      "properties": {
        "kind": { "const": "replied" },
        "to": { "$ref": "#/$defs/runId" },
        "invoke": { "$ref": "#/$defs/id" },
        "call": { "$ref": "#/$defs/lowerName" },
        "outcome": { "enum": ["done", "fail"] },
        "value": { "$ref": "#/$defs/value" }
      },
      "required": ["to", "invoke", "call", "outcome", "value"]
    },
    {
      "description": "A spawned child was started, after the step that spawned it settled, or again on restoring. src is its machine, or its task for a collection of tasks.",
      "properties": {
        "kind": { "const": "spawn.started" },
        "spawn": { "$ref": "#/$defs/id" },
        "children": { "$ref": "#/$defs/lowerName" },
        "key": { "$ref": "#/$defs/key" },
        "src": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*$" },
        "args": { "$ref": "#/$defs/args" }
      },
      "required": ["spawn", "children", "key", "src", "args"]
    },
    {
      "description": "A running spawned child was stopped: by `stop`, by a `spawn` with its key, or because its parent finished or was cancelled.",
      "properties": {
        "kind": { "const": "spawn.stopped" },
        "spawn": { "$ref": "#/$defs/id" },
        "children": { "$ref": "#/$defs/lowerName" },
        "key": { "$ref": "#/$defs/key" }
      },
      "required": ["spawn", "children", "key"]
    },
    {
      "description": "An after timer was started.",
      "properties": {
        "kind": { "const": "timer.started" },
        "timer": { "$ref": "#/$defs/id" },
        "state": { "$ref": "#/$defs/stateId" },
        "index": { "$ref": "#/$defs/safeNatural" },
        "delay": { "$ref": "#/$defs/safeNatural" }
      },
      "required": ["timer", "state", "index", "delay"]
    },
    {
      "description": "A raise effect without a delay put an event on the internal queue.",
      "properties": { "kind": { "const": "raised" }, "value": { "$ref": "#/$defs/tagged" } },
      "required": ["value"]
    },
    {
      "description": "A delayed raise was started (or restarted on restoring, with the time that remains as delay). Its expiry is an after input with this timer.",
      "properties": {
        "kind": { "const": "raise.scheduled" },
        "timer": { "$ref": "#/$defs/id" },
        "name": { "oneOf": [{ "$ref": "#/$defs/lowerName" }, { "type": "null" }] },
        "delay": { "$ref": "#/$defs/safeNatural" },
        "value": { "$ref": "#/$defs/tagged" }
      },
      "required": ["timer", "name", "delay", "value"]
    },
    {
      "description": "A pending delayed raise was cancelled: by cancel, by a delayed raise with the same name, or because the run finished or was cancelled.",
      "properties": {
        "kind": { "const": "raise.cancelled" },
        "timer": { "$ref": "#/$defs/id" },
        "name": { "oneOf": [{ "$ref": "#/$defs/lowerName" }, { "type": "null" }] }
      },
      "required": ["timer", "name"]
    },
    {
      "description": "A running timer was cancelled because its state was left.",
      "properties": {
        "kind": { "const": "timer.cancelled" },
        "timer": { "$ref": "#/$defs/id" },
        "state": { "$ref": "#/$defs/stateId" },
        "index": { "$ref": "#/$defs/safeNatural" }
      },
      "required": ["timer", "state", "index"]
    },
    {
      "description": "The run reached a top-level final state with an output (null if the machine returns nothing). The last record of the run.",
      "properties": {
        "kind": { "const": "done" },
        "state": { "$ref": "#/$defs/stateId" },
        "output": { "$ref": "#/$defs/value" }
      },
      "required": ["state", "output"]
    },
    {
      "description": "The run reached a top-level final state with a fail expression. The last record of the run.",
      "properties": {
        "kind": { "const": "failed" },
        "state": { "$ref": "#/$defs/stateId" },
        "error": { "$ref": "#/$defs/tagged" }
      },
      "required": ["state", "error"]
    },
    {
      "description": "The run was cancelled from outside. The last record of the run.",
      "properties": { "kind": { "const": "cancelled" } }
    },
    {
      "description": "The driver stopped the run, idle, after saving it, or stopped a child run with its idle parent. The last record of the run, which has not ended: it goes on from its saved snapshot.",
      "properties": { "kind": { "const": "suspended" } }
    },
    {
      "description": "The run ended with a defect. The last record of the run.",
      "properties": { "kind": { "const": "defect" }, "defect": { "$ref": "#/$defs/defect" } },
      "required": ["defect"]
    }
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "upperName": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" },
    "lowerName": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
    "name": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*$" },
    "src": {
      "description": "An invoke's task or machine, or for a call the address and the call's name.",
      "type": "string",
      "pattern": "^([A-Za-z][A-Za-z0-9]*|[a-z][A-Za-z0-9]*\\.[a-z][A-Za-z0-9]*)$"
    },
    "stateId": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*(\\.[A-Z][A-Za-z0-9]*)*$" },
    "runId": { "type": "string", "pattern": "^[A-Za-z0-9_-]+(\\.[1-9][0-9]*)*$" },
    "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "safeNatural": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "id": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "value": {
      "description": "A Roadbook value in its JSON form (spec/execution.md#values), redacted: the value of every field, parameter or variable marked sensitive is the string \"<redacted>\" (spec/trace.md#redaction)."
    },
    "key": {
      "description": "A spawned child's key: a string (a string or an enum variant) or an integer.",
      "oneOf": [{ "type": "string" }, { "type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991 }]
    },
    "args": {
      "description": "Arguments keyed by parameter name.",
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/lowerName" }
    },
    "tagged": {
      "description": "An error or event value: an object with _tag and the fields.",
      "type": "object",
      "required": ["_tag"],
      "properties": { "_tag": { "$ref": "#/$defs/upperName" } }
    },
    "event": {
      "description": "An input as the core received it.",
      "type": "object",
      "oneOf": [
        {
          "properties": { "kind": { "const": "event" }, "value": { "$ref": "#/$defs/tagged" } },
          "required": ["kind", "value"],
          "additionalProperties": false
        },
        {
          "description": "A message: run `from` sent one of this machine's events, as its message `message`.",
          "properties": {
            "kind": { "const": "message" },
            "from": { "$ref": "#/$defs/runId" },
            "message": { "$ref": "#/$defs/id" },
            "value": { "$ref": "#/$defs/tagged" }
          },
          "required": ["kind", "from", "message", "value"],
          "additionalProperties": false
        },
        {
          "description": "An emitted event of run `from`, its message `message`. `invoke` is the id of this run's invoke or spawned child that started `from`, or null when this run holds a ref to `from`.",
          "properties": {
            "kind": { "const": "emitted" },
            "from": { "$ref": "#/$defs/runId" },
            "invoke": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
            "message": { "$ref": "#/$defs/id" },
            "value": { "$ref": "#/$defs/tagged" }
          },
          "required": ["kind", "from", "invoke", "message", "value"],
          "additionalProperties": false
        },
        {
          "description": "An event a task emitted while it ran: `invoke` is the id of this run's invoke or spawned task that runs it, and `value` one of the task's emits.",
          "properties": {
            "kind": { "const": "task.emitted" },
            "invoke": { "$ref": "#/$defs/id" },
            "value": { "$ref": "#/$defs/tagged" }
          },
          "required": ["kind", "invoke", "value"],
          "additionalProperties": false
        },
        {
          "description": "A call: run `from` called this machine's call `call` with its invoke `invoke`.",
          "properties": {
            "kind": { "const": "call" },
            "from": { "$ref": "#/$defs/runId" },
            "invoke": { "$ref": "#/$defs/id" },
            "call": { "$ref": "#/$defs/lowerName" },
            "args": { "$ref": "#/$defs/args" }
          },
          "required": ["kind", "from", "invoke", "call", "args"],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": { "const": "invoke.done" },
            "invoke": { "$ref": "#/$defs/id" },
            "value": { "$ref": "#/$defs/value" }
          },
          "required": ["kind", "invoke", "value"],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": { "const": "invoke.fail" },
            "invoke": { "$ref": "#/$defs/id" },
            "error": { "$ref": "#/$defs/tagged" }
          },
          "required": ["kind", "invoke", "error"],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": { "const": "invoke.defect" },
            "invoke": { "$ref": "#/$defs/id" },
            "defect": { "$ref": "#/$defs/defect" }
          },
          "required": ["kind", "invoke", "defect"],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": { "const": "spawn.done" },
            "spawn": { "$ref": "#/$defs/id" },
            "value": { "$ref": "#/$defs/value" }
          },
          "required": ["kind", "spawn", "value"],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": { "const": "spawn.fail" },
            "spawn": { "$ref": "#/$defs/id" },
            "error": { "$ref": "#/$defs/tagged" }
          },
          "required": ["kind", "spawn", "error"],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": { "const": "spawn.defect" },
            "spawn": { "$ref": "#/$defs/id" },
            "defect": { "$ref": "#/$defs/defect" }
          },
          "required": ["kind", "spawn", "defect"],
          "additionalProperties": false
        },
        {
          "properties": { "kind": { "const": "after" }, "timer": { "$ref": "#/$defs/id" } },
          "required": ["kind", "timer"],
          "additionalProperties": false
        },
        {
          "description": "An event the run raised itself, taken from its internal queue.",
          "properties": { "kind": { "const": "raised" }, "value": { "$ref": "#/$defs/tagged" } },
          "required": ["kind", "value"],
          "additionalProperties": false
        },
        {
          "description": "A peer's end: run `from`, which this run holds a ref to, closed, and `status` says how.",
          "properties": {
            "kind": { "const": "ended" },
            "from": { "$ref": "#/$defs/runId" },
            "status": { "enum": ["Done", "Failed", "Cancelled", "Defect", "Suspended"] }
          },
          "required": ["kind", "from", "status"],
          "additionalProperties": false
        }
      ]
    },
    "defect": {
      "type": "object",
      "oneOf": [
        {
          "description": "Host code threw, panicked, or returned a value of the wrong type.",
          "properties": { "kind": { "const": "host" }, "message": { "type": "string" } },
          "required": ["kind", "message"],
          "additionalProperties": false
        },
        {
          "description": "A variable was read before it had a value.",
          "properties": { "kind": { "const": "unassigned" }, "var": { "$ref": "#/$defs/lowerName" } },
          "required": ["kind", "var"],
          "additionalProperties": false
        },
        {
          "description": "Arithmetic left the int range or produced a non-finite float. expr is the operator node's text.",
          "properties": { "kind": { "const": "overflow" }, "expr": { "type": "string" } },
          "required": ["kind", "expr"],
          "additionalProperties": false
        },
        {
          "description": "A task or child machine failed with an error it does not declare.",
          "properties": { "kind": { "const": "undeclared" }, "error": { "$ref": "#/$defs/upperName" } },
          "required": ["kind", "error"],
          "additionalProperties": false
        },
        {
          "description": "Settling took more than 1000 microsteps.",
          "properties": { "kind": { "const": "limit" } },
          "required": ["kind"],
          "additionalProperties": false
        },
        {
          "description": "A strict machine was given one of its own events, a message, a call or a delayed raise's expiry, or raised an event, that enabled no transition. event is the input, of kind event, message, call, after or raised.",
          "properties": {
            "kind": { "const": "unhandled" },
            "event": {
              "allOf": [
                { "$ref": "#/$defs/event" },
                { "properties": { "kind": { "enum": ["event", "message", "call", "after", "raised"] } } }
              ]
            }
          },
          "required": ["kind", "event"],
          "additionalProperties": false
        },
        {
          "description": "A reply was given a pending-call value whose call is not pending.",
          "properties": { "kind": { "const": "answered" }, "call": { "$ref": "#/$defs/lowerName" } },
          "required": ["kind", "call"],
          "additionalProperties": false
        }
      ]
    }
  }
}
