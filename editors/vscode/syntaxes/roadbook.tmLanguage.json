{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Roadbook",
  "scopeName": "source.roadbook",
  "fileTypes": ["road"],
  "patterns": [{ "include": "#code" }],
  "repository": {
    "code": {
      "patterns": [
        { "include": "#comments" },
        { "include": "#strings" },
        { "include": "#import" },
        { "include": "#check" },
        { "include": "#machine-signature" },
        { "include": "#function-signature" },
        { "include": "#call-signature" },
        { "include": "#declarations" },
        { "include": "#messages" },
        { "include": "#target" },
        { "include": "#in-state" },
        { "include": "#keywords" },
        { "include": "#numbers" },
        { "include": "#calls" },
        { "include": "#enum-member" },
        { "include": "#types" },
        { "include": "#fields" },
        { "include": "#operators" },
        { "include": "#names" },
        { "include": "#punctuation" }
      ]
    },

    "comments": {
      "patterns": [
        {
          "name": "comment.line.documentation.roadbook",
          "begin": "///(?!/)",
          "beginCaptures": { "0": { "name": "punctuation.definition.comment.roadbook" } },
          "end": "$",
          "patterns": [
            {
              "name": "markup.inline.raw.roadbook",
              "match": "`[^`]*`"
            }
          ]
        },
        {
          "name": "comment.line.double-slash.roadbook",
          "begin": "//",
          "beginCaptures": { "0": { "name": "punctuation.definition.comment.roadbook" } },
          "end": "$"
        }
      ]
    },

    "strings": {
      "name": "string.quoted.double.roadbook",
      "begin": "\"",
      "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.roadbook" } },
      "end": "(\")|$",
      "endCaptures": { "1": { "name": "punctuation.definition.string.end.roadbook" } },
      "patterns": [
        { "name": "constant.character.escape.roadbook", "match": "\\\\[\"\\\\nt]" },
        { "name": "invalid.illegal.unknown-escape.roadbook", "match": "\\\\." }
      ]
    },

    "import": {
      "patterns": [
        { "match": "\\bimport\\b", "name": "keyword.control.import.roadbook" },
        { "match": "\\bfrom\\b(?=\\s*\")", "name": "keyword.control.import.roadbook" }
      ]
    },

    "machine-signature": {
      "name": "meta.declaration.machine.roadbook",
      "begin": "\\b(?:(strict)\\s+)?(machine)\\s+([A-Z][A-Za-z0-9]*)",
      "beginCaptures": {
        "1": { "name": "storage.modifier.strict.roadbook" },
        "2": { "name": "storage.type.machine.roadbook" },
        "3": { "name": "entity.name.type.machine.roadbook" }
      },
      "end": "(?=[{}])|$",
      "patterns": [{ "include": "#signature-rest" }]
    },

    "function-signature": {
      "name": "meta.declaration.function.roadbook",
      "begin": "\\b(fn|action|task)\\s+([a-z][A-Za-z0-9]*)",
      "beginCaptures": {
        "1": { "name": "storage.type.$1.roadbook" },
        "2": { "name": "entity.name.function.roadbook" }
      },
      "end": "(?=[{}])|$",
      "patterns": [{ "include": "#signature-rest" }]
    },

    "call-signature": {
      "name": "meta.declaration.call.roadbook",
      "begin": "\\b(call)\\s+([a-z][A-Za-z0-9]*)(?=\\s*\\()",
      "beginCaptures": {
        "1": { "name": "storage.type.call.roadbook" },
        "2": { "name": "entity.name.function.roadbook" }
      },
      "end": "(?=[{}])|$",
      "patterns": [{ "include": "#signature-rest" }]
    },

    "signature-rest": {
      "patterns": [
        { "include": "#comments" },
        {
          "name": "meta.parameters.roadbook",
          "begin": "\\(",
          "beginCaptures": { "0": { "name": "punctuation.definition.parameters.begin.roadbook" } },
          "end": "\\)",
          "endCaptures": { "0": { "name": "punctuation.definition.parameters.end.roadbook" } },
          "patterns": [
            { "include": "#comments" },
            { "include": "#sensitive" },
            {
              "match": "\\b([a-z][A-Za-z0-9]*)\\s*(:)",
              "captures": {
                "1": { "name": "variable.parameter.roadbook" },
                "2": { "name": "punctuation.separator.colon.roadbook" }
              }
            },
            { "include": "#types" },
            { "include": "#punctuation" }
          ]
        },
        { "match": "->", "name": "keyword.operator.arrow.roadbook" },
        { "match": "[!|]", "name": "keyword.operator.error.roadbook" },
        {
          "match": "\\b(emits)\\s+([A-Z][A-Za-z0-9]*)",
          "captures": {
            "1": { "name": "storage.type.emits.roadbook" },
            "2": { "name": "entity.name.type.event.roadbook" }
          }
        },
        { "include": "#types" }
      ]
    },

    "declarations": {
      "patterns": [
        {
          "match": "\\b(extern)\\s+(type)\\s+([A-Z][A-Za-z0-9]*)",
          "captures": {
            "1": { "name": "storage.modifier.extern.roadbook" },
            "2": { "name": "storage.type.type.roadbook" },
            "3": { "name": "entity.name.type.roadbook" }
          }
        },
        {
          "match": "\\b(type)\\s+([A-Z][A-Za-z0-9]*)",
          "captures": {
            "1": { "name": "storage.type.type.roadbook" },
            "2": { "name": "entity.name.type.roadbook" }
          }
        },
        {
          "match": "\\b(enum)\\s+([A-Z][A-Za-z0-9]*)",
          "captures": {
            "1": { "name": "storage.type.enum.roadbook" },
            "2": { "name": "entity.name.type.enum.roadbook" }
          }
        },
        {
          "match": "\\b(error)\\s+([A-Z][A-Za-z0-9]*)",
          "captures": {
            "1": { "name": "storage.type.error.roadbook" },
            "2": { "name": "entity.name.type.error.roadbook" }
          }
        },
        {
          "comment": "`internal` is not reserved: it is a modifier only before `event`.",
          "match": "\\b(?:(internal)\\s+(?=event\\b))?(event|emits)\\s+([A-Z][A-Za-z0-9]*)",
          "captures": {
            "1": { "name": "storage.modifier.internal.roadbook" },
            "2": { "name": "storage.type.$2.roadbook" },
            "3": { "name": "entity.name.type.event.roadbook" }
          }
        },
        {
          "match": "(:)\\s*(call)\\s+([a-z][A-Za-z0-9]*)",
          "captures": {
            "1": { "name": "punctuation.separator.colon.roadbook" },
            "2": { "name": "storage.modifier.call.roadbook" },
            "3": { "name": "entity.name.function.roadbook" }
          }
        },
        {
          "match": "\\b(children)\\s+([a-z][A-Za-z0-9]*)\\s*(:)\\s*(?:([A-Z][A-Za-z0-9]*)|(?!by\\b)([a-z][A-Za-z0-9]*))\\s+(by)\\b",
          "captures": {
            "1": { "name": "storage.type.children.roadbook" },
            "2": { "name": "variable.other.definition.roadbook" },
            "3": { "name": "punctuation.separator.colon.roadbook" },
            "4": { "name": "entity.name.type.machine.roadbook" },
            "5": { "name": "entity.name.function.call.roadbook" },
            "6": { "name": "keyword.other.by.roadbook" }
          }
        },
        {
          "match": "\\b(?:(sensitive)\\s+)?(var)\\s+([a-z][A-Za-z0-9]*)",
          "captures": {
            "1": { "name": "storage.modifier.sensitive.roadbook" },
            "2": { "name": "storage.type.var.roadbook" },
            "3": { "name": "variable.other.definition.roadbook" }
          }
        },
        {
          "comment": "A state with parameters: `state Confirming(token: ResetToken)`.",
          "name": "meta.declaration.state.roadbook",
          "begin": "\\b(?:(final|parallel)\\s+)?(state)\\s+([A-Z][A-Za-z0-9]*)\\s*(?=\\()",
          "beginCaptures": {
            "1": { "name": "storage.modifier.$1.roadbook" },
            "2": { "name": "storage.type.state.roadbook" },
            "3": { "name": "entity.name.type.state.roadbook" }
          },
          "end": "(?<=\\))",
          "patterns": [{ "include": "#signature-rest" }]
        },
        {
          "match": "\\b(?:(final|parallel)\\s+)?(state)\\s+([A-Z][A-Za-z0-9]*)",
          "captures": {
            "1": { "name": "storage.modifier.$1.roadbook" },
            "2": { "name": "storage.type.state.roadbook" },
            "3": { "name": "entity.name.type.state.roadbook" }
          }
        },
        {
          "comment": "`choice` is contextual: a choice state only when a state name follows.",
          "match": "\\b(choice)\\s+([A-Z][A-Za-z0-9]*)",
          "captures": {
            "1": { "name": "storage.type.choice.roadbook" },
            "2": { "name": "entity.name.type.state.roadbook" }
          }
        },
        {
          "comment": "`tags` is contextual: a state's tags only at the start of a line, followed by a name.",
          "match": "^\\s*(tags)\\s+([a-z][A-Za-z0-9]*(?:\\s*,\\s*[a-z][A-Za-z0-9]*)*)",
          "captures": {
            "1": { "name": "storage.type.tags.roadbook" },
            "2": { "name": "constant.other.tag.roadbook" }
          }
        },
        {
          "comment": "`meta` is contextual: a state's meta only at the start of a line, followed by `{`. Its keys and values are a record body's.",
          "match": "^\\s*(meta)\\s*(?=\\{)",
          "captures": { "1": { "name": "storage.type.meta.roadbook" } }
        },
        {
          "match": "\\b(?:(deep)\\s+)?(history)\\s+([A-Z][A-Za-z0-9]*)",
          "captures": {
            "1": { "name": "storage.modifier.deep.roadbook" },
            "2": { "name": "storage.type.history.roadbook" },
            "3": { "name": "entity.name.type.state.roadbook" }
          }
        },
        {
          "match": "\\b(initial)\\s+([A-Z][A-Za-z0-9]*)",
          "captures": {
            "1": { "name": "keyword.control.initial.roadbook" },
            "2": { "name": "entity.name.type.state.roadbook" }
          }
        }
      ]
    },

    "messages": {
      "patterns": [
        {
          "match": "\\b(on)\\s+(?:(\\*)|([a-z][A-Za-z0-9]*)(\\.)(?:([A-Z][A-Za-z0-9]*)|(done)\\b|(ended)\\b|(?=fail\\b))|([A-Z][A-Za-z0-9]*(?:\\s*\\|\\s*[A-Z][A-Za-z0-9]*)*)|([a-z][A-Za-z0-9]*)\\b)",
          "captures": {
            "1": { "name": "keyword.control.trigger.roadbook" },
            "2": { "name": "keyword.operator.wildcard.roadbook" },
            "3": { "name": "variable.other.roadbook" },
            "4": { "name": "punctuation.accessor.roadbook" },
            "5": { "name": "entity.name.type.event.roadbook" },
            "6": { "name": "keyword.control.done.roadbook" },
            "7": { "name": "keyword.control.ended.roadbook" },
            "8": {
              "patterns": [
                { "match": "[A-Z][A-Za-z0-9]*", "name": "entity.name.type.event.roadbook" },
                { "match": "\\|", "name": "keyword.operator.event.roadbook" }
              ]
            },
            "9": { "name": "entity.name.function.roadbook" }
          }
        },
        {
          "match": "\\b(invoke)\\s+([a-z][A-Za-z0-9]*)(\\.)([a-z][A-Za-z0-9]*)",
          "captures": {
            "1": { "name": "keyword.control.invoke.roadbook" },
            "2": { "name": "variable.other.roadbook" },
            "3": { "name": "punctuation.accessor.roadbook" },
            "4": { "name": "entity.name.function.call.roadbook" }
          }
        },
        {
          "match": "\\b(reply)\\s+(?:(call)|([a-z][A-Za-z0-9]*))\\s+(done|fail)\\b",
          "captures": {
            "1": { "name": "keyword.other.effect.roadbook" },
            "2": { "name": "variable.language.roadbook" },
            "3": { "name": "variable.other.roadbook" },
            "4": { "name": "keyword.control.$4.roadbook" }
          }
        },
        {
          "match": "\\b(send)\\s+([a-z][A-Za-z0-9]*)(\\.)(?:(\\*)(\\.))?([A-Z][A-Za-z0-9]*)",
          "captures": {
            "1": { "name": "keyword.other.effect.roadbook" },
            "2": { "name": "variable.other.roadbook" },
            "3": { "name": "punctuation.accessor.roadbook" },
            "4": { "name": "keyword.operator.wildcard.roadbook" },
            "5": { "name": "punctuation.accessor.roadbook" },
            "6": { "name": "entity.name.type.event.roadbook" }
          }
        },
        {
          "match": "\\b(send|spawn|stop)\\s+([a-z][A-Za-z0-9]*)(?=\\s*\\[)",
          "captures": {
            "1": { "name": "keyword.other.effect.roadbook" },
            "2": { "name": "variable.other.roadbook" }
          }
        },
        {
          "match": "(?<=\\])(\\.)([A-Z][A-Za-z0-9]*)",
          "captures": {
            "1": { "name": "punctuation.accessor.roadbook" },
            "2": { "name": "entity.name.type.event.roadbook" }
          }
        },
        {
          "comment": "`raise` is not reserved: it is an effect only before an event name.",
          "match": "\\b(emit|raise)\\s+([A-Z][A-Za-z0-9]*)",
          "captures": {
            "1": { "name": "keyword.other.effect.roadbook" },
            "2": { "name": "entity.name.type.event.roadbook" }
          }
        },
        {
          "comment": "`cancel` is not reserved: it is an effect only before a name that is not a keyword.",
          "match": "\\b(cancel)\\s+(?!(?:import|type|enum|error|extern|fn|action|task|machine|strict|var|event|emits|initial|state|final|parallel|entry|exit|on|after|always|done|invoke|output|fail|if|else|set|do|send|emit|ignore|and|or|not|in|true|false|call|reply)\\b)([a-z][A-Za-z0-9]*)",
          "captures": {
            "1": { "name": "keyword.other.effect.roadbook" },
            "2": { "name": "variable.other.roadbook" }
          }
        },
        {
          "match": "\\b(fail)\\s+(?:(\\*)|(Unanswered)\\b|([A-Z][A-Za-z0-9]*))",
          "captures": {
            "1": { "name": "keyword.control.fail.roadbook" },
            "2": { "name": "keyword.operator.wildcard.roadbook" },
            "3": { "name": "support.type.builtin.error.roadbook" },
            "4": { "name": "entity.name.type.error.roadbook" }
          }
        },
        {
          "match": "\\b(as)\\s+([a-z][A-Za-z0-9]*)",
          "captures": {
            "1": { "name": "keyword.control.as.roadbook" },
            "2": { "name": "variable.other.definition.roadbook" }
          }
        },
        {
          "match": "\\b(retry)\\s+([0-9]+)(?:\\s+(on)\\s+([A-Z][A-Za-z0-9]*(?:\\s*\\|\\s*[A-Z][A-Za-z0-9]*)*))?",
          "captures": {
            "1": { "name": "keyword.control.retry.roadbook" },
            "2": { "name": "constant.numeric.integer.roadbook" },
            "3": { "name": "keyword.control.on.roadbook" },
            "4": {
              "patterns": [
                { "match": "[A-Z][A-Za-z0-9]*", "name": "entity.name.type.error.roadbook" },
                { "match": "\\|", "name": "keyword.operator.error.roadbook" }
              ]
            }
          }
        }
      ]
    },

    "target": {
      "comment": "One target or several, separated by commas, each with an optional leading dot (an internal transition), and arguments after the states that take them.",
      "patterns": [
        {
          "comment": "A target list in which a state takes arguments, `-> Editing(doc).Changing`: the arguments are expressions.",
          "begin": "(->)\\s*(?=(?:\\.?[A-Z][A-Za-z0-9]*(?:\\.[A-Z][A-Za-z0-9]*)*\\s*,\\s*)*\\.?[A-Z][A-Za-z0-9]*(?:\\.[A-Z][A-Za-z0-9]*)*\\()",
          "beginCaptures": { "1": { "name": "keyword.operator.arrow.roadbook" } },
          "end": "(?![.(A-Z]|\\s*,\\s*\\.?[A-Z])",
          "patterns": [
            {
              "name": "meta.arguments.roadbook",
              "begin": "\\(",
              "beginCaptures": { "0": { "name": "punctuation.definition.arguments.begin.roadbook" } },
              "end": "\\)",
              "endCaptures": { "0": { "name": "punctuation.definition.arguments.end.roadbook" } },
              "patterns": [{ "include": "#parenthesized" }, { "include": "#code" }]
            },
            { "match": "\\.?[A-Z][A-Za-z0-9]*", "name": "entity.name.type.state.roadbook" },
            { "match": "\\s*,\\s*", "name": "punctuation.separator.comma.roadbook" }
          ]
        },
        {
                    "match": "(->)\\s*(\\.?[A-Z][A-Za-z0-9]*(?:\\.[A-Z][A-Za-z0-9]*)*(?:\\s*,\\s*\\.?[A-Z][A-Za-z0-9]*(?:\\.[A-Z][A-Za-z0-9]*)*)*)",
          "captures": {
            "1": { "name": "keyword.operator.arrow.roadbook" },
            "2": {
              "name": "entity.name.type.state.roadbook",
              "patterns": [{ "match": ",", "name": "punctuation.separator.comma.roadbook" }]
            }
          }
        }
      ]
    },

    "parenthesized": {
      "comment": "Parentheses inside a target's arguments, so that the first `)` does not end them.",
      "begin": "\\(",
      "end": "\\)",
      "patterns": [{ "include": "#parenthesized" }, { "include": "#code" }]
    },

    "check": {
      "comment": "`check` and the words of its property are not reserved: a check is a machine item, at the start of its line, `check` followed by `never`, `reachable`, `can` or a state.",
      "begin": "^\\s*(check)\\b(?=\\s+(?:never|reachable|can|[A-Z]))",
      "beginCaptures": { "1": { "name": "keyword.other.check.roadbook" } },
      "end": "$",
      "patterns": [
        { "include": "#comments" },
        { "match": "\\b(never|reachable|only|after|can|finish)\\b", "name": "keyword.other.check.roadbook" },
        { "match": "\\band\\b", "name": "keyword.operator.logical.roadbook" },
        { "match": "\\b[A-Z][A-Za-z0-9]*\\b", "name": "entity.name.type.state.roadbook" },
        { "match": "\\.", "name": "punctuation.accessor.roadbook" }
      ]
    },

    "in-state": {
      "comment": "`in(Main.Volume.Muted)`: whether a state is active. `in` is a keyword, not a function, and the path names states.",
      "begin": "\\b(in)\\s*(\\()",
      "beginCaptures": {
        "1": { "name": "keyword.operator.in.roadbook" },
        "2": { "name": "punctuation.section.parens.roadbook" }
      },
      "end": "\\)",
      "endCaptures": { "0": { "name": "punctuation.section.parens.roadbook" } },
      "patterns": [
        { "match": "\\b[A-Z][A-Za-z0-9]*\\b", "name": "entity.name.type.state.roadbook" },
        { "match": "\\.", "name": "punctuation.accessor.roadbook" }
      ]
    },

    "sensitive": {
      "comment": "`sensitive` is not reserved: it is a modifier only before a field or parameter name and its `:`, or before `var`.",
      "match": "\\bsensitive(?=\\s+(?:var\\b|[a-z][A-Za-z0-9]*\\s*:))",
      "name": "storage.modifier.sensitive.roadbook"
    },

    "keywords": {
      "patterns": [
        { "include": "#sensitive" },
        {
          "match": "\\b(initial|entry|exit|on|after|always|done|invoke|output|fail|if|else|ignore)\\b",
          "name": "keyword.control.$1.roadbook"
        },
        { "match": "\\b(set|do|send|emit|reply)\\b", "name": "keyword.other.effect.roadbook" },
        {
          "match": "\\b(type|enum|extern|fn|action|task|machine|var|emits|state)\\b",
          "name": "storage.type.$1.roadbook"
        },
        { "match": "\\b(final|parallel|strict)\\b", "name": "storage.modifier.$1.roadbook" },
        { "match": "\\b(and|or|not)\\b", "name": "keyword.operator.logical.roadbook" },
        { "match": "\\b(true|false)\\b", "name": "constant.language.boolean.roadbook" },
        { "match": "\\b(event|error|result|call)\\b", "name": "variable.language.roadbook" },
        { "match": "(?<!\\.)\\b(key)\\b(?!\\s*:)", "name": "variable.language.roadbook" }
      ]
    },

    "numbers": {
      "patterns": [
        {
          "match": "\\b([0-9]+)(ms|s|m|h)\\b",
          "name": "constant.numeric.duration.roadbook",
          "captures": { "2": { "name": "keyword.other.unit.roadbook" } }
        },
        { "match": "\\b[0-9]+\\.[0-9]+\\b", "name": "constant.numeric.float.roadbook" },
        { "match": "\\b[0-9]+\\b", "name": "constant.numeric.integer.roadbook" }
      ]
    },

    "types": {
      "patterns": [
        { "match": "\\bref\\b(?=\\s+[A-Z])", "name": "storage.modifier.ref.roadbook" },
        { "match": "\\b(string|int|float|bool|duration|json)\\b", "name": "support.type.primitive.roadbook" },
        { "match": "\\bmap\\b(?=\\s*<)", "name": "support.type.primitive.roadbook" },
        { "match": "\\b[A-Z][A-Za-z0-9]*\\b", "name": "entity.name.type.roadbook" },
        { "match": "\\[\\]", "name": "keyword.operator.type.list.roadbook" },
        { "match": "\\?", "name": "keyword.operator.type.optional.roadbook" }
      ]
    },

    "calls": {
      "patterns": [
        {
          "match": "\\b([a-z][A-Za-z0-9]*)\\s*(?=\\()",
          "captures": { "1": { "name": "entity.name.function.call.roadbook" } }
        },
        {
          "match": "\\b([A-Z][A-Za-z0-9]*)\\s*(?=\\()",
          "captures": { "1": { "name": "entity.name.type.machine.roadbook" } }
        }
      ]
    },

    "enum-member": {
      "match": "\\b([A-Z][A-Za-z0-9]*)(\\.)([A-Z][A-Za-z0-9]*)",
      "captures": {
        "1": { "name": "entity.name.type.roadbook" },
        "2": { "name": "punctuation.accessor.roadbook" },
        "3": { "name": "variable.other.enummember.roadbook" }
      }
    },

    "fields": {
      "match": "\\b([a-z][A-Za-z0-9]*)\\s*(:)",
      "captures": {
        "1": { "name": "variable.other.property.roadbook" },
        "2": { "name": "punctuation.separator.colon.roadbook" }
      }
    },

    "operators": {
      "patterns": [
        { "match": "->", "name": "keyword.operator.arrow.roadbook" },
        { "match": "==|!=|<=|>=|<|>", "name": "keyword.operator.comparison.roadbook" },
        { "match": "=", "name": "keyword.operator.assignment.roadbook" },
        { "match": "[+\\-*]", "name": "keyword.operator.arithmetic.roadbook" },
        { "match": "[!|]", "name": "keyword.operator.error.roadbook" }
      ]
    },

    "names": {
      "patterns": [
        {
          "match": "(\\.)([a-z][A-Za-z0-9]*)",
          "captures": {
            "1": { "name": "punctuation.accessor.roadbook" },
            "2": { "name": "variable.other.property.roadbook" }
          }
        },
        { "match": "\\b[A-Z][A-Za-z0-9]*\\b", "name": "entity.name.type.roadbook" },
        { "match": "\\b[a-z][A-Za-z0-9]*\\b", "name": "variable.other.roadbook" }
      ]
    },

    "punctuation": {
      "patterns": [
        { "match": ",", "name": "punctuation.separator.comma.roadbook" },
        { "match": ":", "name": "punctuation.separator.colon.roadbook" },
        { "match": "\\.", "name": "punctuation.accessor.roadbook" },
        { "match": "[{}]", "name": "punctuation.section.braces.roadbook" },
        { "match": "[()]", "name": "punctuation.section.parens.roadbook" },
        { "match": "[\\[\\]]", "name": "punctuation.section.brackets.roadbook" }
      ]
    }
  }
}
