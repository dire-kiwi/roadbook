{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": ["node"],
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "declaration": false,
    "sourceMap": false,
    // The examples are not packages: test/examples.test.ts runs their generated modules, whose
    // imports of these two are mapped to this package's (vitest.config.ts does the same).
    "paths": {
      "effect": ["./node_modules/effect/dist/index.d.ts"],
      "@roadbook/effect": ["./src/index.ts"],
      "@roadbook/effect/durable": ["./src/entry-durable.ts"]
    }
  },
  "include": ["src", "test", "vitest.config.ts"]
}
