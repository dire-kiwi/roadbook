// Charts for the durable driver's crash and resume tests (test/durable.test.ts): work that a
// crash must not repeat, a timer and an event to wait for, a child run, and a peer.

/// Write a line to the log.
action log(text: string)
/// One step of work, which a crash must not repeat once it has finished.
task step(n: int) -> int
/// How long `Waiting` waits for a nudge.
fn patience() -> duration
/// How long a Parent waits for its Pipeline.
fn deadline() -> duration

/// Three steps, with a wait between the second and the third for a nudge or a timer.
machine Pipeline(id: string) -> int {
  var total: int = 0

  event Nudge { by: int }

  exit do log("pipeline exited")

  initial One

  state One {
    entry do log("one")
    invoke step(1) {
      done -> Two  set total = total + result
    }
  }

  state Two {
    invoke step(2) {
      done -> Waiting  set total = total + result
    }
  }

  /// Whichever comes first: a nudge, or the timer.
  state Waiting {
    on Nudge         -> Three  set total = total + event.by
    after patience() -> Three
  }

  state Three {
    invoke step(3) {
      done -> Done  set total = total + result
    }
  }

  final state Done { output total }
}

/// Runs a Pipeline as a child and passes nudges on to it. Past its deadline it cancels the
/// Pipeline and does a fourth step instead.
machine Parent(id: string) -> int {
  var total: int = 0

  event Push { by: int }

  initial Running

  state Running {
    invoke Pipeline(id) as pipeline {
      done -> Done  set total = result
    }
    on Push                       send pipeline.Nudge { by: event.by }
    after deadline() -> Fallback
  }

  state Fallback {
    invoke step(4) {
      done -> GaveUp
    }
  }

  final state Done   { output total }
  final state GaveUp { output -1 }
}

/// Adds what it is sent, and emits each new total to the runs holding a `ref` to it.
machine Counter() {
  var n: int = 0

  event Add   { by: int }
  event Close
  emits Total { n: int }

  initial Counting

  state Counting {
    on Add              set n = n + event.by  emit Total { n: n }
    on Close -> Closed
  }

  final state Closed {}
}

/// Works out an amount, sends it to a Counter, and ends once the Counter's total reaches `goal`.
machine Adder(counter: ref Counter, goal: int) -> int {
  initial Working

  state Working {
    invoke step(1) {
      done -> Waiting  send counter.Add { by: result }
    }
  }

  state Waiting { on counter.Total if event.n >= goal -> Reached }

  final state Reached { output goal }
}

/// Counts the ends of its Counter it takes, while it works: once, however the processes
/// running it crash.
machine Watcher(counter: ref Counter) -> int {
  var seen: int = 0

  on counter.ended set seen = seen + 1

  initial Working

  state Working {
    invoke step(1) {
      done -> Done
    }
  }

  final state Done { output seen }
}

/// One session of a Hub: adds up the pings it is sent, does a step of work when asked, and
/// gives up once it has waited `patience()` for anything.
machine Session(name: string) -> int {
  var total: int = 0
  var work:  int = 0

  event Ping  { by: int }
  event Work  { n: int }
  event Leave

  initial Waiting

  state Waiting {
    on Ping                      set total = total + event.by
    on Work          -> Working  set work = event.n
    on Leave         -> Left
    after patience() -> Expired
  }

  state Working {
    invoke step(work) {
      done -> Waiting  set total = total + result
    }
  }

  final state Left    { output total }
  final state Expired { output -1 }
}

/// Spawns a Session per key and passes pings, work and leaving on to it. Adds up what the
/// sessions that end give, and gives the sum when it is finished.
machine Hub(id: string) -> int {
  var total: int = 0

  event Join   { key: string }
  event Tell   { key: string, by: int }
  event Assign { key: string, n: int }
  event Part   { key: string }
  event Finish

  children sessions: Session by string

  initial Serving

  state Serving {
    on Join                   spawn sessions[event.key] = Session(event.key)
    on Tell                   send sessions[event.key].Ping { by: event.by }
    on Assign                 send sessions[event.key].Work { n: event.n }
    on Part                   send sessions[event.key].Leave
    on sessions.done          set total = total + result  do log(key)
    on Finish        -> Done
  }

  final state Done { output total }
}

/// Runs an Adder as its child, which hears the Counter.
machine Relay(counter: ref Counter, goal: int) -> int {
  var got: int = 0

  initial Running

  state Running {
    invoke Adder(counter, goal) {
      done -> Done  set got = result
    }
  }

  final state Done { output got }
}
