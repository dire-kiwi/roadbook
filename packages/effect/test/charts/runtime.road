// Charts for the driver's tests (test/driver.test.ts): the defects the core raises and the
// conformance cases leave out, work left over when a step is cut short, `json` values from
// host code, calls a callee cannot answer, and maps and generic records through the codec.

fn payload()             -> json
action log(what: string)
action hold(n: int)
task work()              -> int

/// `int` overflows the TypeScript runtime's range ±(2^53 - 1) in its output.
machine Overflow() -> int {
  var n: int = 9007199254740991

  initial Over

  final state Over { output n + 1 }
}

/// Settles forever: every microstep takes the `always` again.
machine Settle() {
  var n: int = 0

  initial Spin

  state Spin {
    always {
      if n >= 0 -> Spin  set n = n + 1
    }
  }
}

/// Reads `a` before it has a value, in `b`'s initial value.
machine Early() -> int {
  var a: int
  var b: int = a + 1

  initial Over

  final state Over { output b }
}

/// Outer's work is cancelled after Inner's exit effect, so a defect there leaves it running.
machine Leftover() {
  event Go

  initial Outer

  state Outer {
    invoke work() {
      done -> Over
    }
    on Go -> Over

    initial Inner

    state Inner { exit do log("exit Inner") }
  }

  final state Over {}
}

/// Ends with whatever the host's `payload` returns, which must be JSON.
machine Payload() -> json {
  initial Over

  final state Over { output payload() }
}

/// Answers `ask` with its argument once `hold` has run for it, one call at a time.
machine Desk() {
  call ask(n: int) -> int

  event Close

  initial Open

  state Open {
    on ask              do hold(event.n)  reply call done event.n
    on Close -> Closed
  }

  final state Closed {}
}

/// Asks the desk for `n`; 0 when the desk does not answer.
machine Asker(desk: ref Desk, n: int) -> int {
  var got: int

  initial Asking

  state Asking {
    invoke desk.ask(n) {
      done            -> Got   set got = result
      fail Unanswered -> Gave
    }
  }

  final state Got  { output got }
  final state Gave { output 0 }
}

type Box<T>   { value: T }
type Boxes<T> = map<string, Box<T>>
// Not used by a machine: here so that `tsc` checks the schema of a recursive generic type.
type Tree<T> { value: T, children: Tree<T>[], parent: Tree<T>? }

fn withLongest(boxes: Boxes<duration>) -> Boxes<duration>

/// Ends with what the host's `withLongest` makes of its map of generic records of durations.
machine Generic(boxes: Boxes<duration>) -> Boxes<duration> {
  initial Over

  final state Over { output withLongest(boxes) }
}
