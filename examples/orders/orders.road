// `inventory` is another package: the root `roadbook.toml` maps it to `examples/inventory`.
import { Inventory, Item, OutOfStock } from "inventory/inventory.road"

/// What the customer is buying.
type OrderDraft { items: Item[], card: string }

/// Proof of payment.
type Receipt { orderId: string, total: int }

/// The card was refused.
error PaymentDeclined

/// Charge the customer for the order.
task charge(orderId: string, draft: OrderDraft) -> Receipt ! PaymentDeclined

/// Reserve the items with the warehouse, then take the payment. The warehouse is a peer that
/// lives longer than any order: whoever starts the order passes it in.
machine Order(id: string, draft: OrderDraft, inventory: ref Inventory) -> Receipt ! OutOfStock | PaymentDeclined {
  var receipt: Receipt
  var problem: OutOfStock

  initial Reserving

  /// The warehouse answers this order's call alone. `Unanswered` is the built-in error of a
  /// warehouse that has closed, or closes before it answers.
  state Reserving {
    invoke inventory.reserve(id, draft.items) {
      done            -> Paying
      fail OutOfStock -> Unavailable  set problem = error
      fail Unanswered -> Unavailable  set problem = OutOfStock { reason: "the warehouse is closed" }
    }
    after 5s -> Unavailable  set problem = OutOfStock { reason: "the warehouse did not answer" }
  }

  state Paying {
    invoke charge(id, draft) {
      done                 -> Paid      set receipt = result
      fail PaymentDeclined -> Declined  send inventory.Release { orderId: id }
    }
  }

  final state Paid        { output receipt }
  final state Unavailable { fail problem }
  final state Declined    { fail PaymentDeclined }
}
