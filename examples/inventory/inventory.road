/// One line of an order: a product and how many of it.
type Item { sku: string, qty: int }

/// The warehouse cannot supply every item.
error OutOfStock { reason: string }

/// Hold `items` for an order, or fail if the warehouse cannot supply them all.
task reserveStock(warehouse: string, orderId: string, items: Item[]) ! OutOfStock

/// Put the items held for an order back on the shelf.
action releaseStock(warehouse: string, orderId: string)

/// Record a delivery.
action addStock(warehouse: string, sku: string, qty: int)

/// The stock of one warehouse, shared by every order. An order calls `reserve`, and the answer
/// goes to that order alone.
machine Inventory(warehouse: string) {
  /// Hold the items for an order, or fail if the warehouse cannot supply them all.
  call reserve(orderId: string, items: Item[]) ! OutOfStock

  var pending: call reserve
  var orderId: string
  var items:   Item[]

  event Release { orderId: string }
  event Restock { sku: string, qty: int }
  event Close

  initial Ready

  on Release do releaseStock(warehouse, event.orderId)
  on Restock do addStock(warehouse, event.sku, event.qty)

  /// Waiting for the next call.
  state Ready {
    on reserve -> Reserving  set pending = call, orderId = event.orderId, items = event.items
    on Close   -> Closed
  }

  /// One reservation at a time: a call that arrives meanwhile is turned away at once.
  state Reserving {
    invoke reserveStock(warehouse, orderId, items) {
      done            -> Ready  reply pending done
      fail OutOfStock -> Ready  reply pending fail error
    }
    on reserve reply call fail OutOfStock { reason: "busy" }
  }

  final state Closed {}
}
