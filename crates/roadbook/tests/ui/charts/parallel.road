// A chart with a parallel state, which the Rust macro does not support until milestone 6.

machine Both() {
  event Ping

  initial Running

  parallel state Running {
    state Left {
      initial L1
      state L1 { on Ping -> L2 }
      final state L2 {}
    }
    state Right {
      initial R1
      state R1 { on Ping -> R2 }
      final state R2 {}
    }
    done -> Over
  }

  final state Over {}
}
