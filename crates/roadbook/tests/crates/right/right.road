// A fixture of roadbook's tests: one side of a diamond of crates.
import { Inventory } from "inventory/inventory.road"

/// Restocks its inventory with one right item.
machine Right(stock: ref Inventory) {
  event Go

  initial Idle

  state Idle { on Go -> Done  send stock.Restock { sku: "right", qty: 1 } }

  final state Done {}
}
