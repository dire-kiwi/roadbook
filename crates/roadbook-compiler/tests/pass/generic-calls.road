// Calls whose parameters and results are maps and instances of generic types, with no
// diagnostics.

/// Something for sale.
type Item { sku: string, qty: int }

/// A page of results.
type Page<T> { items: T[], next: string? }

/// Counts by name.
type Counts = map<string, int>

/// The items of `page` that `stock` has enough of.
fn inStock(stock: map<string, int>, page: Page<Item>) -> Page<Item>

/// The counts of a page's items, by sku.
fn countsOf(page: Page<Item>) -> Counts

/// Searches its stock.
machine Catalog() {
  /// The items of `page` in stock.
  call search(stock: map<string, int>, page: Page<Item>) -> Page<Item>
  /// The counts of a page's items, by sku.
  call count(page: Page<Item>) -> Counts

  var last: Page<Item>?

  event Close

  initial Open

  state Open {
    on search            set last = event.page  reply call done inStock(event.stock, event.page)
    on count             reply call done countsOf(event.page)
    on Close  -> Closed
  }

  final state Closed {}
}

/// Asks the catalog about a page of items, then counts what is in stock.
machine Shopper(catalog: ref Catalog, stock: Counts, wanted: Page<Item>) -> Counts {
  var found:  Page<Item> = wanted
  var counts: map<string, int>

  initial Searching

  state Searching {
    invoke catalog.search(stock, wanted) {
      done            -> Counting  set found = result
      fail Unanswered -> Failed
    }
  }

  state Counting {
    invoke catalog.count(Page { items: found.items, next: found.next }) {
      done            -> Counted  set counts = result
      fail Unanswered -> Failed
    }
  }

  final state Counted { output counts }
  final state Failed  { output countsOf(wanted) }
}
