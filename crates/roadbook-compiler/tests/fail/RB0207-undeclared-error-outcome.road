error CardDeclined
error GatewayUnavailable
error Timeout
task chargeCard() ! CardDeclined | GatewayUnavailable

machine M() {
  initial A
  state A {
    invoke chargeCard() {
      done                   -> Done
      fail CardDeclined      -> Done
      fail GatewayUnavailabe -> Done
      fail Timeout           -> Done
      fail *                 -> Done
    }
  }
  final state Done {}
}

