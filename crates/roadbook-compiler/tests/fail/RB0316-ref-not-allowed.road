machine Peer() {
  event Hello { from: ref Peer }
  initial A
  state A {
    on Hello -> A
  }
}

type Holder { peer: ref Peer }
type Peers = ref Peer[]
error Gone { peers: Peers }
fn find(id: string) -> ref Peer
task look(id: string) -> ref Peer?

machine Asked() {
  call hello(who: ref Peer)
  initial A
  state A {
    on hello reply call done
  }
}

