type Go { a: int }
error Stop
machine Child() {
  initial Done
  final state Done {}
}

machine M() {
  event Go
  event Stop
  event Child
  event Fine
  initial A
  state A {
    on Go    -> A
    on Stop  -> A
    on Child -> A
    on Fine  -> A
  }
}

