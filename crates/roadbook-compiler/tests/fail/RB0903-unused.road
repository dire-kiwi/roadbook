fn helper(n: int) -> int
fn used(n: int) -> bool
action ping()
task fetch()

machine M() {
  event Go
  event Unused
  var n: int = 0
  initial A
  state A {
    on Go if used(n) -> Done
  }
  final state Done {}
}

