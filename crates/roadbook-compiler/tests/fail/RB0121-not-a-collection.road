machine Child() {
  event Ping
  emits Pong
  initial A
  state A {
    on Ping -> A  emit Pong
  }
}

machine M(peer: ref Child) {
  event Go { id: string }
  children kids: Child by string
  var n: int = 0
  initial A
  state A {
    invoke Child() as one {
      done -> A
    }
    on Go     spawn kids[event.id] = Child()  send kids.Ping
    on one.done -> A
  }
  on kids.Pong  stop peer[1]
  on n.done     send peer["x"].Ping
  on kid.fail * send kids.*.Ping
}

