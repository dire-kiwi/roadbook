machine Child() {
  event Poke
  initial A
  state A {
    on Poke -> A
  }
}

machine M() {
  event Go
  event Leave
  initial Running
  state Running {
    entry send child.Poke
    exit send child.Poke
    invoke Child() as child {
      done -> Done  send child.Poke
    }
    on Go send child.Poke
    on Leave -> Done  send child.Poke
    initial Inner
    state Inner {
      entry send child.Poke
      exit send child.Poke
      on Go -> Running.Other  send child.Poke
      on Leave -> Running  send child.Poke
    }
    state Other {}
  }
  final state Done {}
}

// A transition between the regions of the invoking parallel state leaves it; an internal one
// written in it does not.
machine N() {
  event Go
  event Stay
  initial P
  parallel state P {
    invoke Child() as child { done -> Done }
    on Stay -> .B.B2  send child.Poke
    state A { on Go -> P.B.B2  send child.Poke }
    state B {
      initial B1
      state B1 {}
      state B2 {}
    }
  }
  final state Done {}
}

// With several invokes, an outcome of one finds the others running, unless it leaves the
// state; an outcome of `a` never finds `a` running.
machine S() {
  initial Both
  state Both {
    invoke Child() as a {
      done            send b.Poke
    }
    invoke Child() as b {
      done -> Done    send a.Poke
    }
    invoke Child() as c {
      done            send c.Poke
    }
  }
  final state Done {}
}

