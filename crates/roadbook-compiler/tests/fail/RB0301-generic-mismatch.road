type Page<T> { items: T[] }
type Dict<T> = map<string, T>

fn ints() -> int[]
fn names() -> map<string, string>

machine M() -> Page<string> {
  var counts: Dict<int> = names()
  var page: Page<int?> = Page { items: ints() }
  initial Done
  final state Done { output Page { items: ints() } }
}

