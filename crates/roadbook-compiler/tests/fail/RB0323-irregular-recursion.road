type Nested<T> { inner: Nested<T[]>? }
type Swap<A, B> { next: Swap<B, A>? }
type Tree<T> { value: T, children: Tree<T>[] }
type Even<T> { odd: Odd<T>? }
type Odd<T> { even: Even<T>? }

