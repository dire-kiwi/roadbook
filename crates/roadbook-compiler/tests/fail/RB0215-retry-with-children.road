error Busy
task ping() ! Busy

machine M() {
  initial A
  state A {
    invoke ping() retry 2 {
      done      -> B
      fail Busy -> B
    }
    initial Inner
    state Inner {}
  }
  parallel state P {
    invoke ping() retry 1 {
      done      -> B
      fail Busy -> B
    }
    state R {}
  }
  final state B {}
}

