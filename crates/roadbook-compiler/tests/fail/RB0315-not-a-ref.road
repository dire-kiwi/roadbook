machine Peer() {
  event Ping
  initial A
  state A {
    on Ping -> A
  }
}

machine M(count: int, maybe: ref Peer?, many: ref Peer[]) {
  event Go
  initial A
  state A {
    on Go send count.Ping
    on maybe.Pong -> A
  }
  on Go send many.Ping
}

