type Page<T> { items: T[] }
type Pair<A, B> { first: A, second: B }
type Order { id: string }
type Wrap<T> { inner: T<int>, all: Pair<T> }

machine M(page: Page, two: Page<int, int>, order: Order<int>) {
  initial Done
  final state Done {}
}

