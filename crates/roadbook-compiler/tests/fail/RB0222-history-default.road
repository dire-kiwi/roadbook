machine M() {
  event Go

  initial A
  state A {
    initial B
    history H -> B, C
    state B { on Go -> A.H }
    state C {}
  }
  parallel state P {
    history H -> L.X, L.Y
    state L {
      initial X
      state X { on Go -> P.H }
      state Y {}
    }
    state R {}
  }
}

