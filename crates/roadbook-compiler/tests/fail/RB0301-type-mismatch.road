error Declined { reason: string }
fn delay(attempt: int) -> duration
action note(what: string)

machine M(name: string) {
  var ratio: float = 1
  var count: int = 0
  var maybe: int?
  var declined: Declined = Declined { reason: 5 }
  initial A
  state A {
    entry set count = name, count = maybe
    entry do note(count)
    after delay(name) -> B
    after 5 -> B
  }
  state B {
    always {
      if count -> Done
      else     -> Done
    }
  }
  final state Done {}
}

