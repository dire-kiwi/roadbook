type Order { id: string, extra: json }

machine M(order: Order, other: Order, name: string) {
  var n: int = 1
  var x: float = 1.5
  var b: bool = true
  initial A
  state A {
    entry set n = n + 1.5, x = x * 2, n = -b
    always if not n -> Done
  }
  state D {
    always if order == other -> Done
  }
  state B {
    always if name < "b" and n -> Done
  }
  state C {
    always if 1s + 2s > 2s or n == x -> Done
  }
  final state Done {}
}

