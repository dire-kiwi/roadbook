machine Upload() {
  event Pause
  emits Progress { percent: int }
  initial Sending
  state Sending {
    entry emit Progres { percent: 1 }
    on Pause -> Done  emit Pause
  }
  final state Done {}
}

machine M(peer: ref Upload) {
  initial A
  state A {
    invoke Upload() as upload {
      done -> Done
    }
    on upload.Pause -> Done
    on peer.Finished -> Done
  }
  final state Done {}
}

