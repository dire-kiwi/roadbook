type Creds { user: string, sensitive password: string, sensitive ttl: duration }
type Note { text: string }
error Refused { sensitive why: string, code: int }
action log(what: string)
action keep(sensitive what: string)
task check(user: string, sensitive password: string) -> bool
fn strong(password: string) -> bool
fn ttl(password: string) -> duration

machine Child(sensitive secret: string, shown: string) {
  initial A
  final state A {}
}

machine Peer() {
  event Hello { sensitive token: string, plain: string }
  initial A
  state A { on Hello -> A }
}

machine M(sensitive key: string, creds: Creds, peer: ref Peer) -> string ! Refused {
  event Submit { sensitive password: string, user: string }
  emits Seen { sensitive password: string, user: string }
  sensitive var kept: string = key
  var leaked: string = key
  var copy: Creds = creds
  var note: Note
  var why: Refused
  sensitive var hidden: Refused = Refused { why: key, code: 2 }

  initial A
  state A {
    on Submit if strong(event.password) -> B
      set leaked = event.password, kept = event.password, note = Note { text: creds.password }
      do log(event.password), keep(event.password), log(creds.user)
      send peer.Hello { token: event.password, plain: event.password }
      emit Seen { password: event.password, user: event.password }
    after ttl(key) -> B
    after copy.ttl -> B
  }
  state B {
    invoke check(creds.user, creds.password) {
      done {
        if result -> C
        else      -> D  set why = Refused { why: key, code: 1 }
      }
    }
  }
  state C {
    invoke Child(key, key) { done -> E }
    after 1s -> F
  }
  final state D { fail why }
  final state E { output kept }
  final state F { fail hidden }
}

