machine Child(n: int) -> int {
  initial Done
  final state Done { output n }
}

machine M() {
  event Go { id: string }
  children kids: Child by int
  var total: string = ""
  initial A
  state A {
    on Go        spawn kids[event.id] = Child("one")  stop kids["x"]  send kids[true].Nothing
    on kids.done set total = result
  }
}

