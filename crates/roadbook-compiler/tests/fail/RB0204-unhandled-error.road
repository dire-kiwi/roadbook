type Receipt { id: string }
error CardDeclined { reason: string }
error GatewayUnavailable
task chargeCard(amount: int) -> Receipt ! CardDeclined | GatewayUnavailable

machine Checkout(amount: int) {
  initial Charging
  state Charging {
    invoke chargeCard(amount) {
      done -> Charged
    }
  }
  final state Charged {}
}

