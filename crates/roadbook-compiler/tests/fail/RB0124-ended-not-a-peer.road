machine Upload() {
  initial A
  final state A {}
}

machine M() {
  children uploads: Upload by string
  initial A
  on uploads.ended -> A
  state A {
    invoke Upload() as upload {
      done -> B
    }
    on upload.ended -> B
  }
  state B {
    on upload.ended -> A
  }
}

