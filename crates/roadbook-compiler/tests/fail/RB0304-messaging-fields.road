machine Peer() {
  event Reserve { qty: int }
  emits Reserved
  initial A
  state A {
    on Reserve -> A  emit Reserved { qty: 1 }
  }
}

machine M(peer: ref Peer) {
  initial A
  state A {
    entry send peer.Reserve { qty: 1, sku: "x" }
  }
}

