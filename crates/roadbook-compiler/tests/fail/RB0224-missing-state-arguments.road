type Doc { text: string }

machine M(doc: Doc) {
  event Go
  event Edit

  initial Idle
  state Idle {
    on Go   -> Editing
    on Edit -> Editing.Changing
  }
  state Editing(d: Doc) {
    initial Viewing
    state Viewing {}
    state Changing {}
  }
}

