action note(flag: bool)

machine M() {
  event Go

  initial Main
  parallel state Main {
    state Volume {
      initial Loud
      state Loud  { on Go if in(Volume.Muted) -> Muted }
      state Muted { on Go if in(Main.Volume.Mute) -> Loud }
    }
    state Playback {
      initial Playing
      state Playing {
        entry do note(in(M.Main.Volume))
        on Go if in(Mian) -> Playing
      }
    }
  }
}

