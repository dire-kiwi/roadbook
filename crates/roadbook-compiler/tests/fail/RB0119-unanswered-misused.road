error Busy

task work() ! Busy

machine Peer() {
  call ask() ! Unanswered
  initial A
  state A {
    on ask reply call fail Unanswered
    invoke work() {
      done            -> A
      fail Busy       -> A
      fail Unanswered -> A
    }
  }
}

machine M(x: Unanswered) {
  initial A
  final state A {}
}

