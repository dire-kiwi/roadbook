machine M() {
  event Go

  initial A
  state A {
    initial B
    history H -> Takes
    deep history D -> Outer.Inner
    state B             { on Go -> A.H }
    state C             { on Go -> A.D }
    state Takes(n: int) {}
    state Outer(label: string) {
      initial Inner
      state Inner {}
    }
  }
}

