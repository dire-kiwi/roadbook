task fetch() -> string emits Ready

machine Job() {
  initial Done
  final state Done {}
}

machine M(id: string) {
  var count: int = 0
  children jobs: Job by string
  event Go

  initial Idle
  on Go -> A(1)
  state Idle {
    on Go raise Go after 1s as later
  }
  state A(n: int) {
    var id: string = ""
    var jobs: int = 0
    var later: int = 0
    var up: int = 0
    initial B
    state B {
      var n: int = 1
      invoke fetch() as up
      on up.Ready -> C
    }
    state C {
      var count: int = 0
    }
  }
}

// expect: RB0127 at 19:9
