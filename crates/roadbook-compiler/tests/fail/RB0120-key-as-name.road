machine Child() {
  initial Done
  final state Done {}
}

machine M(key: string) {
  event Go
  children kids: Child by string
  initial A
  state A {
    on Go spawn kids[key] = Child()
  }
}

machine N() {
  event Go
  children key: Child by string
  var other: int = 0
  initial A
  state A {
    on Go spawn key["a"] = Child()
  }
}

machine P() {
  var key: int = 0
  initial A
  state A {}
}

machine Q() {
  initial A
  state A {
    invoke Child() as key {
      done -> A
    }
  }
}

// expect: RB0120 at 6:11
// expect: RB0120 at 17:12
// expect: RB0120 at 26:7
// expect: RB0120 at 34:23
