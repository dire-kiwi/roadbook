type Pending = call reserve

fn f(p: call reserve) -> int

machine M() {
  call reserve()
  call other(p: call reserve)
  var a: call reserve?
  var b: call reserve[]
  var c: call reserve = 1
  event E { p: call reserve }
  initial A
  state A {
    on reserve reply call done
    on other reply call done
    on E -> A
  }
}

