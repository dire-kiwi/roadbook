type Pair<T> { first: T, second: T }

fn describe(value: json) -> string

machine M() {
  event Ping { n: int }
  var text: string = ""
  initial Idle
  state Idle {
    on Ping -> Idle  set text = describe(Pair { first: 1, second: "one" })
    after 1s -> Idle  set text = describe(Pair { first: 1, second: 2 })
  }
  state Other {
    on Ping -> Idle  set text = describe(Pair { first: event, second: event })
  }
}

// expect: RB0327 at 10:42
// expect: RB0327 at 14:42
