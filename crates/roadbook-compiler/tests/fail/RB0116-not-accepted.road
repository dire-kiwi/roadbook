machine Upload() {
  event Pause
  emits Progress { percent: int }
  initial Sending
  state Sending {
    entry emit Progress { percent: 1 }
    on Pause -> Done
  }
  final state Done {}
}

machine M(peer: ref Upload) {
  event Go
  initial A
  state A {
    invoke Upload() as upload {
      done -> Done
    }
    on Go send upload.Paus
  }
  final state Done {}
  on Go send peer.Progress { percent: 1 }
}

