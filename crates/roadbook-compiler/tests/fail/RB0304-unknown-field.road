type Order { id: string, total: int }

machine M(order: Order) {
  var id: string = order.idd
  var copy: Order = Order { id: "x", total: 1, note: "y" }
  event Go { sku: string }
  initial A
  state A {
    on Go if event.skuu == "a" -> Done
  }
  final state Done {}
}

