type Order { id: string }
error Boom
task boom() ! Boom
action log(s: string)

machine M(order: Order?, items: Order[]) {
  event Cancel
  var n: int = 0
  var a: string = order.id
  var b: string = items.id
  var c: int = n.size
  initial A
  state A {
    on Cancel -> Done  set a = event.why
    invoke boom() {
      fail Boom -> Done  do log(error.why)
    }
  }
  final state Done {}
}

