// A payment that is approved can be refunded, so `never Refunded` does not hold, and the
// counterexample relies on the guard.
fn approved() -> bool

machine Payment() {
  event Pay
  event Refund

  initial Idle

  state Idle {
    on Pay {
      if approved() -> Charged
      else          -> Declined
    }
  }
  state Charged        { on Refund -> Refunded }
  final state Refunded {}
  final state Declined {}

  check never Refunded
}

// expect: RB0501 at 21:3
